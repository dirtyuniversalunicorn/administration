// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  runtime  = "workerd"
}

// Same models, Node runtime: only used by the seed script (src/prisma/seed.ts).
// The app itself runs on Cloudflare Workers and uses the workerd client above.
generator seedClient {
  provider = "prisma-client"
  output   = "../generated/prisma-node"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
}

/// Users are never deleted: INACTIVE users cannot sign in but keep their authored content.
enum UserStatus {
  ACTIVE
  INACTIVE
}

/// ADMIN: everything, including delete and user management. EDITOR: read, create, edit. USER: read only.
enum UserRole {
  ADMIN
  EDITOR
  USER
}

model User {
  id            String     @id
  email         String     @unique
  name          String?
  emailVerified Boolean    @default(false)
  image         String?
  status        UserStatus @default(ACTIVE)
  role          UserRole   @default(USER)
  deactivatedAt DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  sessions      Session[]
  accounts      Account[]
  items         Item[]     @relation("ItemPostedBy")
  editedItems   Item[]     @relation("ItemEditedBy")
  contact       Contact[]  @relation("ContactPostedBy")
  editedContact Contact[]  @relation("ContactEditedBy")
  blogs         Blog[]     @relation("BlogPostedBy")
  editedBlogs   Blog[]     @relation("BlogEditedBy")

  @@index([status])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum SubscriptionStatus {
  PENDING // signed up, email not confirmed yet
  ACTIVE // confirmed via the link in the confirmation email
  INACTIVE // unsubscribed via the link in an email
}

// Visitor subscription with double opt-in. Rows are never deleted: unsubscribing
// sets INACTIVE (+ cancelledAt); subscribing again goes back through PENDING.
model Subscription {
  id                    String             @id @default(cuid())
  email                 String             @unique
  status                SubscriptionStatus @default(PENDING)
  // Random single-use token in the confirmation link; cleared once confirmed.
  confirmToken          String?            @unique
  confirmTokenExpiresAt DateTime?
  confirmSentAt         DateTime?
  // Random permanent token used in unsubscribe links inside emails.
  unsubscribeToken      String             @unique
  subscribedAt          DateTime?
  cancelledAt           DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([status])
  @@map("subscription")
}

enum ItemStatus {
  ACTIVE // shown in the client-facing app
  INACTIVE // hidden from the client-facing app, kept in the database
}

model Item {
  id            String     @id @default(cuid())
  postedById    String
  postedBy      User       @relation("ItemPostedBy", fields: [postedById], references: [id])
  createdAt     DateTime   @default(now())
  editedAt      DateTime   @updatedAt
  // Who made the last change (set on create, edit and status change).
  editedById    String
  editedBy      User       @relation("ItemEditedBy", fields: [editedById], references: [id])
  category      String
  imageUrl      String
  technique     String
  status        ItemStatus @default(ACTIVE)
  deactivatedAt DateTime?

  @@index([status])
  @@index([postedById])
  @@index([category])
  @@index([createdAt])
  @@map("item")
}

model Contact {
  id           String  @id @default(cuid())
  email        String?
  phone        String?
  mobile       String?
  address      String?
  openingHours String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  postedById String
  postedBy   User   @relation("ContactPostedBy", fields: [postedById], references: [id])

  // Who made the last change (set on create and on every edit).
  editedById String
  editedBy   User   @relation("ContactEditedBy", fields: [editedById], references: [id])

  @@map("contact")
}

enum BlogStatus {
  ACTIVE // shown in the client-facing app
  INACTIVE // hidden from the client-facing app, kept in the database
}

model Blog {
  id            String     @id @default(cuid())
  title         String
  // Short summary shown in lists. Optional.
  excerpt       String?
  // The post itself, plain text (line breaks are kept).
  content       String
  // Cover image link. Optional.
  imageUrl      String?
  status        BlogStatus @default(ACTIVE)
  deactivatedAt DateTime?

  createdAt  DateTime @default(now())
  editedAt   DateTime @updatedAt
  postedById String
  postedBy   User     @relation("BlogPostedBy", fields: [postedById], references: [id])
  // Who made the last change (set on create, edit and status change).
  editedById String
  editedBy   User     @relation("BlogEditedBy", fields: [editedById], references: [id])

  @@index([status])
  @@index([createdAt])
  @@map("blog")
}
